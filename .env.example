# LLM API Keys (At least one required for live model execution)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default Model Provider Selection (groq, openrouter, gemini, openai)
DEFAULT_LLM_PROVIDER=groq

# Model Configurations
FAST_MODEL_NAME=llama-3.1-8b-instant
REASONING_MODEL_NAME=llama-3.3-70b-versatile

# Vector Database Path
FAISS_INDEX_PATH=rag/faiss_index
